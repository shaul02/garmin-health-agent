# Copy this file to  .streamlit/secrets.toml  and fill in your values.
# NEVER commit the real secrets.toml (it is in .gitignore).

[garmin]
GARMIN_EMAIL = "you@example.com"
GARMIN_PASSWORD = "your-garmin-connect-password"
# Only needed if you get a "Display name is not set" error: the id shown in
# connect.garmin.com/modern/profile/<id> when you view your own profile.
# GARMIN_DISPLAY_NAME = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

[ai]
# provider: rules | gemini | claude | openai | ollama
# "rules" needs no API key at all and still gives a full readiness analysis.
AI_PROVIDER = "gemini"

# Free tier: create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY = "your-google-ai-studio-key"
GEMINI_MODEL = "gemini-2.5-flash"

# ANTHROPIC_API_KEY = "sk-ant-..."
# CLAUDE_MODEL = "claude-sonnet-5"
# OPENAI_API_KEY = "sk-..."
# OPENAI_MODEL = "gpt-4o-mini"
# OLLAMA_HOST = "http://localhost:11434"
# OLLAMA_MODEL = "llama3.1"

# SLEEP_TARGET_HOURS = "7.5"
